package main

import (
	"fmt"
	"github.com/dustin/go-humanize"
	"sort"
	"strings"
	"time"
)

type lineupPlayerSelectOption struct {
	Player       Player
	CurrentIndex int
	Label        string
	Group        int
}

func lineupPlayerIDAt(players []LineupPlayer, indexNumber int) uint {
	for _, lp := range players {
		if lp.IndexNumber == indexNumber && lp.SlotOrder == 0 {
			return lp.PlayerID
		}
	}
	return 0
}

func lineupPlayerIDAtSlot(players []LineupPlayer, indexNumber int, slotOrder int) uint {
	for _, lp := range players {
		if lp.IndexNumber == indexNumber && lp.SlotOrder == slotOrder {
			return lp.PlayerID
		}
	}
	return 0
}

func lineupSubMinuteAtSlot(players []LineupPlayer, indexNumber int, slotOrder int) int {
	for _, lp := range players {
		if lp.IndexNumber == indexNumber && lp.SlotOrder == slotOrder {
			return lp.SubMinute
		}
	}
	return 0
}

func lineupLastAssignedSlot(players []LineupPlayer, indexNumber int) int {
	lastSlot := 0
	for _, lp := range players {
		if lp.IndexNumber == indexNumber && lp.PlayerID != 0 && lp.SlotOrder > lastSlot {
			lastSlot = lp.SlotOrder
		}
	}
	return lastSlot
}

func lineupSubMinuteLabel(minute int) string {
	if minute <= 0 {
		return ""
	}
	return fmt.Sprintf(" %d'", minute)
}

func lineupPositionInitials(positionName string) string {
	normalized := normalizedLineupPosition(positionName)
	if normalized == "" {
		return ""
	}
	switch normalized {
	case "goalkeeper", "keeper":
		return "GK"
	case "striker":
		return "ST"
	case "forward":
		return "FWD"
	case "defender", "defence", "defense":
		return "DEF"
	case "midfielder", "midfield":
		return "MID"
	case "winger", "wing":
		return "W"
	}
	parts := strings.Fields(normalized)
	if len(parts) == 1 {
		upper := strings.ToUpper(parts[0])
		runes := []rune(upper)
		if len(runes) <= 3 {
			return upper
		}
		return string(runes[:3])
	}
	initials := ""
	for _, part := range parts {
		for _, r := range part {
			initials += strings.ToUpper(string(r))
			break
		}
	}
	return initials
}

func lineupPlayerIndexForPlayer(players []LineupPlayer, playerID uint) int {
	for _, lp := range players {
		if lp.PlayerID == playerID {
			return lp.IndexNumber
		}
	}
	return -1
}

func lineupPositionNamesByIndex(positions []FormationPosition) map[int]string {
	names := map[int]string{}
	for _, position := range positions {
		name := lineupPositionInitials(position.PositionName)
		if name == "" {
			name = fmt.Sprintf("position %d", position.IndexNumber)
		}
		names[position.IndexNumber] = name
	}
	return names
}

func normalizedLineupPosition(value string) string {
	value = strings.ToLower(strings.TrimSpace(value))
	replacer := strings.NewReplacer("-", " ", "_", " ", "/", " ", ",", " ", ".", " ")
	return strings.Join(strings.Fields(replacer.Replace(value)), " ")
}

func lineupPositionTokens(value string) map[string]bool {
	normalized := normalizedLineupPosition(value)
	tokens := map[string]bool{}
	if normalized == "" {
		return tokens
	}
	tokens[normalized] = true
	for _, token := range strings.Fields(normalized) {
		tokens[token] = true
	}
	return tokens
}

func lineupPositionCategory(value string) string {
	tokens := lineupPositionTokens(value)
	switch {
	case tokens["gk"] || tokens["goalkeeper"] || tokens["keeper"]:
		return "keeper"
	case tokens["cb"] || tokens["lb"] || tokens["rb"] || tokens["lwb"] || tokens["rwb"] || tokens["def"] || tokens["defender"] || tokens["defence"] || tokens["defense"] || tokens["back"]:
		return "defence"
	case tokens["dm"] || tokens["cm"] || tokens["am"] || tokens["lm"] || tokens["rm"] || tokens["mid"] || tokens["midfield"] || tokens["midfielder"]:
		return "midfield"
	case tokens["lw"] || tokens["rw"] || tokens["st"] || tokens["cf"] || tokens["fwd"] || tokens["forward"] || tokens["striker"] || tokens["wing"] || tokens["winger"] || tokens["attack"] || tokens["attacker"]:
		return "attack"
	default:
		return ""
	}
}

func playerPositionText(player Player) string {
	return strings.TrimSpace(strings.Join([]string{player.Role, player.RoleDescription}, " "))
}

func playerMatchesLineupPosition(player Player, positionName string) bool {
	playerTokens := lineupPositionTokens(playerPositionText(player))
	if len(playerTokens) == 0 {
		return false
	}
	for token := range lineupPositionTokens(positionName) {
		if playerTokens[token] {
			return true
		}
	}
	return false
}

func playerNearMatchesLineupPosition(player Player, positionName string) bool {
	positionCategory := lineupPositionCategory(positionName)
	if positionCategory == "" {
		return false
	}
	return lineupPositionCategory(playerPositionText(player)) == positionCategory
}

func lineupPlayerSelectOptions(players []Player, lineupPlayers []LineupPlayer, positions []FormationPosition, targetIndex int, targetPosition string, selectedPlayerID uint, unavailablePlayerIDs map[uint]bool) []lineupPlayerSelectOption {
	positionNames := lineupPositionNamesByIndex(positions)
	options := []lineupPlayerSelectOption{}
	for _, player := range players {
		if !lineupPlayerOptionVisible(unavailablePlayerIDs, selectedPlayerID, player.ID) {
			continue
		}
		currentIndex := lineupPlayerIndexForPlayer(lineupPlayers, player.ID)
		assigned := currentIndex >= 0
		group := 2
		if assigned {
			group = 3
		} else if playerMatchesLineupPosition(player, targetPosition) {
			group = 0
		} else if playerNearMatchesLineupPosition(player, targetPosition) {
			group = 1
		}
		label := player.Name
		if assigned {
			assignedPosition := positionNames[currentIndex]
			if assignedPosition == "" {
				assignedPosition = fmt.Sprintf("position %d", currentIndex)
			}
			if currentIndex == targetIndex {
				label = fmt.Sprintf("%s (assigned here)", player.Name)
			} else {
				label = fmt.Sprintf("%s (assigned: %s)", player.Name, assignedPosition)
			}
		}
		options = append(options, lineupPlayerSelectOption{
			Player:       player,
			CurrentIndex: currentIndex,
			Label:        label,
			Group:        group,
		})
	}
	sort.SliceStable(options, func(i, j int) bool {
		if options[i].Group != options[j].Group {
			return options[i].Group < options[j].Group
		}
		return strings.ToLower(options[i].Player.Name) < strings.ToLower(options[j].Player.Name)
	})
	return options
}

func pitchPopupEdgeClass(x float64) string {
	if x <= 24 {
		return "popup-align-left"
	}
	if x >= 76 {
		return "popup-align-right"
	}
	return ""
}

func markerEditorClass(position FormationPosition) string {
	classes := []string{"marker-editor", "hidden"}
	if position.Y > 58 {
		classes = append(classes, "editor-up")
	}
	if edgeClass := pitchPopupEdgeClass(position.X); edgeClass != "" {
		classes = append(classes, edgeClass)
	}
	return strings.Join(classes, " ")
}

func matchDayMarkerPopupClass(position FormationPosition) string {
	classes := []string{"match-day-marker-popup", "hidden"}
	if edgeClass := pitchPopupEdgeClass(position.X); edgeClass != "" {
		classes = append(classes, edgeClass)
	}
	return strings.Join(classes, " ")
}

func matchDayStartInputValue(match Match) string {
	startTime := matchDayStartTime(match)
	if startTime == nil {
		return ""
	}
	return startTime.Format("2006-01-02T15:04")
}

func matchDayStartDataValue(match Match) string {
	startTime := matchDayStartTime(match)
	if startTime == nil {
		return ""
	}
	return startTime.Format("2006-01-02T15:04:05")
}

func matchDayKickoffLongLabel(match Match) string {
	startTime := matchDayStartTime(match)
	if startTime == nil {
		return ""
	}
	now := time.Now()
	if startTime.Sub(now) <= time.Hour {
		return ""
	}
	return strings.TrimSpace(humanize.RelTime(now, *startTime, "", ""))
}

func matchDayClockStarted(match Match) bool {
	return matchDayClockStateForMatch(match).Started
}

func matchDayLiveMinuteLabel(match Match, playerTime MatchDayPlayerTime) string {
	if matchDayStartTime(match) == nil || !playerTime.Current {
		return ""
	}
	return fmt.Sprintf("%d min on", playerTime.LiveMinutes)
}

func matchDayScore(match Match) (int, int) {
	us := 0
	them := 0
	for _, event := range match.Events {
		switch event.EventType {
		case "goal":
			us++
		case "conceded-goal", "own-goal", "opponent-goal":
			them++
		}
	}
	return us, them
}

func matchDayQuickSubCandidateIDs(lineupPlayers []LineupPlayer, currentPlayerID uint, playerTimes []MatchDayPlayerTime, unavailablePlayerIDs map[uint]bool) map[uint]bool {
	playerIDs := map[uint]bool{}
	for _, lineupPlayer := range lineupPlayers {
		if lineupPlayer.PlayerID == 0 || lineupPlayer.PlayerID == currentPlayerID {
			continue
		}
		if matchDayPlayerCurrentlyOn(playerTimes, lineupPlayer.PlayerID) || playerUnavailableForMatch(unavailablePlayerIDs, lineupPlayer.PlayerID) {
			continue
		}
		playerIDs[lineupPlayer.PlayerID] = true
	}
	return playerIDs
}

func matchDayAlternativeLineups(lineups []Lineup, selected *Lineup) []Lineup {
	if selected == nil {
		return lineups
	}
	alternatives := []Lineup{}
	for _, lineup := range lineups {
		if lineup.ID != selected.ID {
			alternatives = append(alternatives, lineup)
		}
	}
	return alternatives
}

func matchDayLineupOptionLabel(lineup Lineup) string {
	label := fmt.Sprintf("%s - %s", lineup.Name, lineup.Status)
	if lineup.Match.ID > 0 {
		label = fmt.Sprintf("%s - %s", label, lineup.Match.Opponent)
	}
	return label
}

func matchDayLineupHasFormation(lineup Lineup) bool {
	return lineup.FormationID > 0 && lineup.Formation.ID > 0
}

func matchDayLineupFormationLabel(lineup Lineup) string {
	if matchDayLineupHasFormation(lineup) {
		return fmt.Sprintf("Formation: %s", lineup.Formation.Name)
	}
	return "No formation attached"
}

func matchDayMatchOptionLabel(match Match) string {
	label := fmt.Sprintf("%s - %s", match.Opponent, match.Location)
	if match.StartTime != nil {
		label = fmt.Sprintf("%s - %s", label, match.StartTime.Format("Mon 2 Jan, 3:04 PM"))
	}
	return label
}

templ matchDayLineupChoice(lineup Lineup) {
	if matchDayLineupHasFormation(lineup) {
		<a href={ fmt.Sprintf("/match-day/%d", lineup.ID) } class="drawer-row-action">
			<span class="block font-bold">{ matchDayLineupOptionLabel(lineup) }</span>
			<span class="block text-sm font-semibold opacity-80">{ matchDayLineupFormationLabel(lineup) }</span>
		</a>
	} else {
		<div class="rounded-lg border border-gray-200 bg-gray-100 px-3 py-2 text-gray-500 cursor-not-allowed" aria-disabled="true">
			<div class="font-bold">{ matchDayLineupOptionLabel(lineup) }</div>
			<div class="text-sm font-semibold">{ matchDayLineupFormationLabel(lineup) }</div>
		</div>
	}
}

templ matchDayLineupAssignChoice(lineup Lineup, match Match) {
	if matchDayLineupHasFormation(lineup) && !lineup.Locked {
		<form method="POST" action={ fmt.Sprintf("/match-day/%d/action", lineup.ID) }>
			<input type="hidden" name="action" value="set-match"/>
			<input type="hidden" name="matchId" value={ fmt.Sprintf("%d", match.ID) }/>
			<button type="submit" class="drawer-row-action">
				<span class="block font-bold">{ matchDayLineupOptionLabel(lineup) }</span>
				<span class="block text-sm font-semibold opacity-80">Assign to { matchDayMatchOptionLabel(match) }</span>
			</button>
		</form>
	} else {
		<div class="rounded-lg border border-gray-200 bg-gray-100 px-3 py-2 text-gray-500 cursor-not-allowed" aria-disabled="true">
			<div class="font-bold">{ matchDayLineupOptionLabel(lineup) }</div>
			if lineup.Locked {
				<div class="text-sm font-semibold">Unlock before assigning</div>
			} else {
				<div class="text-sm font-semibold">{ matchDayLineupFormationLabel(lineup) }</div>
			}
		</div>
	}
}

func matchDaySortedEvents(match Match) []MatchEvent {
	events := []MatchEvent{}
	for _, event := range match.Events {
		if event.EventType == matchDayEventInit {
			continue
		}
		events = append(events, event)
	}
	sort.SliceStable(events, func(i, j int) bool {
		if events[i].EventMinute != events[j].EventMinute {
			return events[i].EventMinute > events[j].EventMinute
		}
		return events[i].CreatedAt.After(events[j].CreatedAt)
	})
	return events
}

func matchDayEventWhenLabel(event MatchEvent) string {
	parts := []string{}
	parts = append(parts, fmt.Sprintf("%d'", event.EventMinute))
	if event.EventTime != nil {
		parts = append(parts, event.EventTime.Format("3:04 PM"))
	}
	return strings.Join(parts, " - ")
}

func matchDayEventLabel(event MatchEvent) string {
	name := strings.TrimSpace(event.EventName)
	if name != "" {
		return name
	}
	eventType := strings.TrimSpace(event.EventType)
	if eventType != "" {
		return eventType
	}
	return fmt.Sprintf("event %d", event.ID)
}

templ lineupStylesAndScript() {
	<style>
		html,
		body {
			width: 100%;
			max-width: 100%;
			overflow-x: hidden;
		}
		* {
			box-sizing: border-box;
		}
		.pitch-shell {
			min-height: 100vh;
			width: 100%;
			max-width: 100vw;
			background: #104c23;
			position: relative;
			overflow-x: hidden;
			overflow-y: hidden;
		}
		.pitch {
			position: absolute;
			inset: 0;
			width: 100%;
			max-width: 100vw;
			overflow: visible;
			background:
				radial-gradient(circle at 50% 50%, rgba(98, 174, 22, .24), transparent 58%),
				repeating-linear-gradient(180deg, #2f8f07 0 8.333%, #1e7205 8.333% 16.666%);
			box-shadow: inset 0 0 90px rgba(0,0,0,.42);
		}
		.pitch-lines {
			position: absolute;
			inset: 52px 34px 118px;
			border: 4px solid rgba(239,246,255,.82);
			border-radius: 2px;
			pointer-events: none;
		}
		.pitch-lines:before {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			top: 50%;
			border-top: 4px solid rgba(239,246,255,.82);
		}
		.pitch-lines:after {
			content: "";
			position: absolute;
			width: min(34vw, 190px);
			height: min(34vw, 190px);
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			border: 4px solid rgba(239,246,255,.82);
			border-radius: 999px;
		}
		.pitch-dot {
			position: absolute;
			left: 50%;
			top: 50%;
			width: 12px;
			height: 12px;
			transform: translate(-50%, -50%);
			border-radius: 999px;
			background: rgba(239,246,255,.9);
			pointer-events: none;
		}
		.pitch-box {
			position: absolute;
			left: 22%;
			width: 56%;
			height: 15%;
			border: 4px solid rgba(239,246,255,.82);
			pointer-events: none;
		}
		.pitch-box.top { top: 0; border-top: 0; }
		.pitch-box.bottom { bottom: 0; border-bottom: 0; }
		.goal-box {
			position: absolute;
			left: 38%;
			width: 24%;
			height: 7%;
			border: 4px solid rgba(239,246,255,.82);
			pointer-events: none;
		}
		.goal-box.top { top: 0; border-top: 0; }
		.goal-box.bottom { bottom: 0; border-bottom: 0; }
		.goal-frame {
			position: absolute;
			left: 42%;
			width: 16%;
			height: 34px;
			border: 4px solid rgba(239,246,255,.82);
			pointer-events: none;
		}
		.goal-frame.top { top: -38px; }
		.goal-frame.bottom { bottom: -38px; }
		.penalty-arc {
			position: absolute;
			left: 50%;
			width: min(30vw, 150px);
			height: min(30vw, 150px);
			transform: translateX(-50%);
			border: 4px solid rgba(239,246,255,.82);
			border-radius: 999px;
			pointer-events: none;
		}
		.penalty-arc.top {
			top: 9.5%;
			clip-path: inset(50% 0 0 0);
		}
		.penalty-arc.bottom {
			bottom: 9.5%;
			clip-path: inset(0 0 50% 0);
		}
		.corner {
			position: absolute;
			width: 36px;
			height: 36px;
			border: 4px solid rgba(239,246,255,.82);
			pointer-events: none;
		}
		.corner.tl { top: -4px; left: -4px; border-right: 0; border-bottom: 0; border-radius: 0 0 36px 0; }
		.corner.tr { top: -4px; right: -4px; border-left: 0; border-bottom: 0; border-radius: 0 0 0 36px; }
		.corner.bl { bottom: -4px; left: -4px; border-right: 0; border-top: 0; border-radius: 0 36px 0 0; }
		.corner.br { bottom: -4px; right: -4px; border-left: 0; border-top: 0; border-radius: 36px 0 0 0; }
		.pitch-marker {
			position: absolute;
			transform: translate(-50%, -50%);
