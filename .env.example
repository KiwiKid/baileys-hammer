PASS=pass
DATABASE_URL=/tmp/data/dev.db
PREVIEW_ENV=true
#PORT=8080

# Google admin auth.
# When GOOGLE_CLIENT_ID is set, Google sign-in is required for admin access
# and the PASS/team-password admin login paths are disabled.
#GOOGLE_CLIENT_ID=

# Separate secret for signing Google admin sessions. Do not reuse PASS.
#GOOGLE_CLIENT_SECRET=

# Optional recovery/bootstrap helper. On startup, any existing admin user with
# this email is granted the super-admin role.
#ADD_SUPER_ADMIN_TO_EMAIL_ON_STARTUP=

# DB_REPLICA_URL=s3://[bucketName]/[bucketPath]
